# Copy to .env and fill in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/psy_marketplace?schema=public"

# Placeholder until the brand is chosen.
NEXT_PUBLIC_BRAND_NAME="BRAND NAME"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# Development seed accounts (npx prisma db seed). Never use in production.
SEED_ADMIN_EMAIL="admin@example.test"
SEED_PASSWORD="change-me-dev-only"

# Encrypts messages and intake answers (32 bytes, base64). Back it up: data
# encrypted with a lost key cannot be recovered.
DATA_ENCRYPTION_KEY="generate-with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))""

# Protects /api/cron/notifications (send as: Authorization: Bearer <secret>).
CRON_SECRET="change-me"

# Optional providers. Without them emails/SMS are written to the server log.
RESEND_API_KEY=""
EMAIL_FROM="BRAND NAME <bookings@example.com>"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""

# Connection pool size per server process, and build concurrency (set BUILD_CPUS=1 with prisma dev).
DATABASE_POOL_MAX="10"
BUILD_CPUS=""

# Name on card statements (neutral, 5-22 chars). Used once card payments are enabled.
PAYMENT_STATEMENT_DESCRIPTOR="BOOKING SERVICES"
# Public client testimonials are off by default (ethics codes). Enable only after review.
PUBLIC_TESTIMONIALS="false"
