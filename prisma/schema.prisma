// Data model.
// Section 1: market, languages, currency, session types.
// Section 2: user roles (client, psychologist, admin), auth sessions,
//            license verification, disputes, audit log.
// Section 3: taxonomy, availability, booking, payments, saved psychologists,
//            messaging, notifications, feedback.
// Section 4: onboarding, documents, payout details, plans, calendar sync,
//            approval flow, video rooms, session notes, invoices (myDATA),
//            payouts, profile analytics.
// Section 5: admin panel: review moderation, editable taxonomy and
//            languages, CMS (blog + static pages), search log, refunds.
// Section 6: risk flag on intake, SMS discretion setting.
// Section 7: consent records (GDPR Art. 7/9), TOTP two-factor auth,
//            card payments (Stripe Checkout) with expiring holds.
//
// Conventions
// - Money is stored as integer cents with an explicit currency (EUR for now).
// - All timestamps are stored in UTC; display uses the market's time zone.
// - Translatable text lives in *Translation tables keyed by locale, so adding
//   a language needs no schema change.
// - "Psychologist" is the role name and covers psychotherapists too; the
//   professional title is stored separately.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  el
  en
}

enum Currency {
  EUR
}

enum SessionType {
  in_person
  video
  phone
}

enum UserRole {
  client
  psychologist
  admin
}

enum UserStatus {
  active
  suspended
}

enum ProfessionalTitle {
  psychologist
  psychotherapist
  clinical_psychologist
  counselling_psychologist
}

enum VerificationStatus {
  pending
  verified
  rejected
  suspended
}

enum AppointmentStatus {
  /// Card checkout in progress: holds the slot, not yet visible to the psychologist.
  awaiting_payment
  pending
  confirmed
  cancelled_by_client
  cancelled_by_psychologist
  completed
  no_show
}

enum Gender {
  female
  male
  nonbinary
  undisclosed
}

enum SpecialtyKind {
  concern
  approach
  client_type
}

enum AppointmentKind {
  session
  /// Free 15-minute introductory call.
  intro_call
}

enum PaymentMethod {
  pay_at_session
  card
}

enum PaymentStatus {
  pending
  /// Card authorised (manual capture), charged when the psychologist accepts.
  authorized
  paid
  refunded
  waived
  failed
}

enum NotificationChannel {
  email
  sms
}

enum NotificationKind {
  booking_confirmation
  reminder_24h
  reminder_1h
  cancellation
  reschedule
  new_message
  /// Client: request received, waiting for the psychologist to accept.
  booking_pending
  booking_accepted
  booking_declined
  /// Psychologist: someone booked (or requested) a session.
  psychologist_new_booking
}

enum DocumentKind {
  license
  identity
  degree
  photo
}

enum ModerationStatus {
  pending
  approved
  rejected
}

enum ContentKind {
  article
  page
}

enum ContentStatus {
  draft
  published
}

enum InvoiceStatus {
  draft
  issued
  transmitted
  failed
  cancelled
}

enum PayoutStatus {
  scheduled
  paid
  failed
}

enum NotificationStatus {
  pending
  sent
  failed
  skipped
}

enum DisputeStatus {
  open
  under_review
  resolved
  rejected
}

/// Markets the platform operates in. Greece first, more EU countries later.
model Country {
  code     String   @id @db.Char(2) // ISO 3166-1 alpha-2
  currency Currency @default(EUR)
  timeZone String // IANA, e.g. Europe/Athens
  enabled  Boolean  @default(false)

  cities        City[]
  psychologists PsychologistProfile[]
}

model City {
  id          String @id @default(cuid())
  countryCode String @db.Char(2)
  slug        String
  latitude    Float?
  longitude   Float?

  country      Country           @relation(fields: [countryCode], references: [code])
  translations CityTranslation[]
  offices      Office[]

  @@unique([countryCode, slug])
}

model CityTranslation {
  cityId String
  locale Locale
  name   String

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([cityId, locale])
}

// ─── Users and auth ─────────────────────────────────────────────────────────

model User {
  id                  String     @id @default(cuid())
  email               String     @unique
  emailVerifiedAt     DateTime?
  /// scrypt hash, see src/lib/auth/password.ts. "!" = no password (Google or magic-link only).
  passwordHash        String
  /// Google account id ("sub"), set when the person signs in with Google.
  googleSub           String?    @unique
  name                String
  phone               String?
  role                UserRole   @default(client)
  status              UserStatus @default(active)
  /// UI and email language preference.
  locale              Locale     @default(el)
  createdAt           DateTime   @default(now())
  updatedAt           DateTime   @updatedAt
  lastSignInAt        DateTime?
  /// Reminder preferences. SMS needs a phone number.
  emailReminders      Boolean    @default(true)
  smsReminders        Boolean    @default(false)
  /// Leave the platform name out of SMS, for discretion.
  smsHideBrand        Boolean    @default(false)
  /// TOTP two-factor auth. Secret is encrypted; recovery codes are SHA-256 hashes.
  totpSecretEncrypted String?
  totpEnabledAt       DateTime?
  recoveryCodeHashes  String[]
  /// Soft delete for GDPR erasure requests; personal fields are scrubbed.
  deletedAt           DateTime?

  sessions            AuthSession[]
  psychologistProfile PsychologistProfile?  @relation("ProfileOwner")
  clientAppointments  Appointment[]         @relation("ClientAppointments")
  disputesOpened      Dispute[]             @relation("DisputeOpener")
  disputesResolved    Dispute[]             @relation("DisputeResolver")
  verificationsDone   PsychologistProfile[] @relation("ProfileVerifier")
  auditEntries        AuditLog[]
  saved               SavedPsychologist[]
  clientConversations Conversation[]        @relation("ClientConversations")
  messagesSent        Message[]
  notifications       Notification[]
  feedbackGiven       Feedback[]
  consents            ConsentRecord[]
  loginTokens         LoginToken[]
  clientProfile       ClientProfile?
  licenseReviews      LicenseVerification[] @relation("LicenseReviewer")
  notesAbout          SessionNote[]         @relation("NoteClient")

  @@index([role, status])
}

/// Server-side login session. The cookie holds a random token; only its
/// SHA-256 hash is stored, so a database leak does not leak live sessions.
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Psychologists ──────────────────────────────────────────────────────────

model PsychologistProfile {
  id                         String             @id @default(cuid())
  userId                     String             @unique
  slug                       String             @unique
  countryCode                String             @db.Char(2)
  title                      ProfessionalTitle
  /// License to practise, checked by an admin before the profile is public.
  licenseNumber              String
  licensingAuthority         String
  /// Stripe Connect Express account for card payouts (split payments).
  stripeAccountId            String?            @unique
  /// Onboarding finished and transfers enabled: card payments can be offered.
  stripeReady                Boolean            @default(false)
  verificationStatus         VerificationStatus @default(pending)
  verifiedAt                 DateTime?
  verifiedById               String?
  /// Shown to the psychologist when an application is rejected.
  rejectionReason            String?
  practisingSince            Int?
  photoUrl                   String?
  /// Optional intro video (YouTube/Vimeo URL, embedded privacy-friendly).
  videoUrl                   String?
  gender                     Gender             @default(undisclosed)
  /// Offers a free 15-minute intro call.
  introCallEnabled           Boolean            @default(false)
  /// Free cancellation up to this many hours before a session.
  cancellationHours          Int                @default(24)
  /// Share of the price charged for a late cancellation or no-show.
  lateCancellationFeePercent Int                @default(100)
  /// Minimum notice for new bookings, in hours.
  bookingNoticeHours         Int                @default(12)
  /// How far ahead clients can book, in days.
  bookingWindowDays          Int                @default(60)
  /// Minutes kept free after each session.
  bufferMinutes              Int                @default(10)
  /// When true, new bookings wait for the psychologist to accept them.
  requiresApproval           Boolean            @default(false)
  /// Onboarding wizard progress; submittedAt marks "sent for verification".
  onboardingStep             Int                @default(0)
  submittedAt                DateTime?
  planId                     String?
  planStartedAt              DateTime?
  /// Secret token for the read-only calendar feed (Google/Outlook subscribe).
  calendarFeedToken          String?            @unique
  /// Payout details. IBAN and tax number are encrypted (src/lib/crypto.ts).
  payoutAccountHolder        String?
  payoutIbanEncrypted        String?
  payoutIbanLast4            String?
  taxIdEncrypted             String?
  taxOffice                  String?
  /// myDATA credentials for issuing receipts as this psychologist (encrypted).
  mydataUserEncrypted        String?
  mydataKeyEncrypted         String?
  /// Languages the psychologist can hold sessions in (ISO 639-1 codes).
  sessionLanguages           String[]
  /// Psychologist's own switch; the profile is public only when this is true
  /// AND verificationStatus is verified.
  published                  Boolean            @default(false)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  user          User                             @relation("ProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy    User?                            @relation("ProfileVerifier", fields: [verifiedById], references: [id])
  country       Country                          @relation(fields: [countryCode], references: [code])
  translations  PsychologistProfileTranslation[]
  offerings     SessionOffering[]
  offices       Office[]
  specialties   PsychologistSpecialty[]
  appointments  Appointment[]
  education     PsychologistEducation[]
  faqs          PsychologistFaq[]
  availability  AvailabilityRule[]
  exceptions    AvailabilityException[]
  licenseHistory LicenseVerification[]
  savedBy       SavedPsychologist[]
  conversations Conversation[]
  feedback      Feedback[]
  plan          Plan?                            @relation(fields: [planId], references: [id])
  documents     Document[]
  calendars     ExternalCalendar[]
  notes         SessionNote[]
  invoices      Invoice[]
  payouts       Payout[]
  stats         ProfileStat[]

  @@index([countryCode, verificationStatus, published])
}

/// Per-language profile text. A psychologist may write in one or both languages.
model PsychologistProfileTranslation {
  psychologistId String
  locale         Locale
  headline       String
  bio            String  @db.Text
  approach       String? @db.Text

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([psychologistId, locale])
}

/// A bookable session format with its own duration and price.
model SessionOffering {
  id              String      @id @default(cuid())
  psychologistId  String
  type            SessionType
  durationMinutes Int         @default(50)
  priceCents      Int
  currency        Currency    @default(EUR)
  active          Boolean     @default(true)
  /// Required for in-person sessions.
  officeId        String?

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  office       Office?             @relation(fields: [officeId], references: [id])

  @@unique([psychologistId, type])
  @@index([type, active])
}

model Office {
  id                   String  @id @default(cuid())
  psychologistId       String
  cityId               String
  addressLine          String
  postalCode           String
  latitude             Float?
  longitude            Float?
  /// Accessibility details matter for in-person care.
  wheelchairAccessible Boolean @default(false)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  city         City                @relation(fields: [cityId], references: [id])
  offerings    SessionOffering[]
}

/// Concerns, approaches and client types. Slugs match src/domain/taxonomy.ts;
/// labels live in the dictionaries so they are type-checked per language.
model Specialty {
  id            String                  @id @default(cuid())
  slug          String                  @unique
  kind          SpecialtyKind
  /// Labels per language, e.g. {"el": "Άγχος", "en": "Anxiety"}. Edited by admins.
  labels        Json                    @default("{}")
  active        Boolean                 @default(true)
  sortOrder     Int                     @default(0)
  psychologists PsychologistSpecialty[]

  @@index([kind, active])
}

/// Session languages offered on the platform. Edited by admins.
model Language {
  /// ISO 639-1 code, e.g. "el".
  code      String  @id
  labels    Json    @default("{}")
  active    Boolean @default(true)
  sortOrder Int     @default(0)
}

model PsychologistSpecialty {
  psychologistId String
  specialtyId    String

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  specialty    Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([psychologistId, specialtyId])
}

model PsychologistEducation {
  id             String @id @default(cuid())
  psychologistId String
  degree         String
  institution    String
  year           Int?
  sortOrder      Int    @default(0)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
}

model PsychologistFaq {
  id             String @id @default(cuid())
  psychologistId String
  locale         Locale
  question       String
  answer         String @db.Text
  sortOrder      Int    @default(0)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, locale])
}

/// Weekly working hours in the market's local time.
model AvailabilityRule {
  id             String        @id @default(cuid())
  psychologistId String
  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday        Int
  /// Minutes after local midnight, e.g. 540 = 09:00.
  startMinute    Int
  endMinute      Int
  /// Formats offered in this window; empty means all active formats.
  sessionTypes   SessionType[]

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, weekday])
}

/// Holidays and blocked time (UTC).
enum ExceptionKind {
  /// Blocked: holiday, sick day, conference.
  unavailable
  /// Extra hours outside the weekly rules (e.g. one Saturday morning).
  available
}

/// One-off change to the weekly AvailabilityRules for a date range.
model AvailabilityException {
  id             String        @id @default(cuid())
  psychologistId String
  kind           ExceptionKind @default(unavailable)
  startsAt       DateTime // UTC
  endsAt         DateTime // UTC
  /// For extra hours: formats offered (empty = all the psychologist's formats).
  sessionTypes   SessionType[] @default([])
  note           String?

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, startsAt])
}

model SavedPsychologist {
  userId         String
  psychologistId String
  createdAt      DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([userId, psychologistId])
}

// ─── Appointments and disputes ──────────────────────────────────────────────

/// Minimal appointment record. Booking rules come in a later section.
model Appointment {
  id                String            @id @default(cuid())
  clientId          String
  psychologistId    String
  sessionType       SessionType
  status            AppointmentStatus @default(pending)
  startsAt          DateTime // UTC
  endsAt            DateTime // UTC
  /// Snapshot of the price at booking time, so later price changes don't
  /// rewrite history.
  priceCents        Int
  currency          Currency          @default(EUR)
  /// Language the session will be held in.
  locale            Locale
  kind              AppointmentKind   @default(session)
  paymentMethod     PaymentMethod     @default(pay_at_session)
  cancelledAt       DateTime?
  /// True when cancelled inside the psychologist's cancellation window.
  lateCancellation  Boolean           @default(false)
  /// Incremented on every change so calendar apps update the .ics event.
  icsSequence       Int               @default(0)
  rescheduledFromId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client          User                @relation("ClientAppointments", fields: [clientId], references: [id])
  psychologist    PsychologistProfile @relation(fields: [psychologistId], references: [id])
  disputes        Dispute[]
  payment         Payment?
  feedback        Feedback?
  notifications   Notification[]
  rescheduledFrom Appointment?        @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment?        @relation("Reschedule")
  videoRoom       VideoRoom?
  notes           SessionNote[]
  invoice         Invoice?
  intake          IntakeForm?

  @@index([psychologistId, startsAt])
  @@index([clientId, startsAt])
}

model Payment {
  id              String        @id @default(cuid())
  appointmentId   String        @unique
  amountCents     Int
  currency        Currency      @default(EUR)
  method          PaymentMethod
  status          PaymentStatus @default(pending)
  /// Payment provider and its reference (e.g. "stripe", PaymentIntent id).
  provider        String?
  providerRef     String?
  /// Sequential receipt number, assigned when the payment is marked paid.
  receiptNumber   String?       @unique
  /// Refunds recorded by an admin (card refunds also go through the provider).
  refundedCents   Int           @default(0)
  refundedAt      DateTime?
  refundReason    String?
  /// Platform commission for this payment (snapshot of the plan at booking).
  commissionCents Int           @default(0)
  /// Unpaid online checkouts release the slot after this time.
  expiresAt       DateTime?
  paidAt          DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

/// Private feedback after a session. Never public unless the client opts in
/// AND the reviews policy allows publishing.
model Feedback {
  id               String           @id @default(cuid())
  appointmentId    String           @unique
  clientId         String
  psychologistId   String
  /// 1-5
  rating           Int
  comment          String?          @db.Text
  publicConsent    Boolean          @default(false)
  /// Only consented AND approved feedback is shown publicly (anonymously).
  moderationStatus ModerationStatus @default(pending)
  moderationNote   String?
  moderatedAt      DateTime?
  moderatedById    String?
  createdAt        DateTime         @default(now())

  appointment  Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       User                @relation(fields: [clientId], references: [id])
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id])

  @@index([psychologistId])
  @@index([moderationStatus, createdAt])
}

// ─── Messaging and notifications ────────────────────────────────────────────

/// One thread per client-psychologist pair. Opened only after a booking.
model Conversation {
  id             String   @id @default(cuid())
  clientId       String
  psychologistId String
  createdAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())

  client       User                @relation("ClientConversations", fields: [clientId], references: [id])
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id])
  messages     Message[]

  @@unique([clientId, psychologistId])
  @@index([psychologistId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  /// AES-256-GCM encrypted body (src/lib/crypto.ts).
  bodyEncrypted  String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

/// Outbox for emails and SMS. A cron job sends due rows.
model Notification {
  id            String              @id @default(cuid())
  userId        String
  appointmentId String?
  kind          NotificationKind
  channel       NotificationChannel
  status        NotificationStatus  @default(pending)
  scheduledFor  DateTime
  sentAt        DateTime?
  attempts      Int                 @default(0)
  error         String?
  createdAt     DateTime            @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([appointmentId])
}

/// A complaint about an appointment (no-show, billing, conduct). Opened by
/// the client or the psychologist, handled by an admin.
model Dispute {
  id            String        @id @default(cuid())
  appointmentId String
  openedById    String
  reason        String        @db.Text
  status        DisputeStatus @default(open)
  resolution    String?       @db.Text
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  openedBy    User        @relation("DisputeOpener", fields: [openedById], references: [id])
  resolvedBy  User?       @relation("DisputeResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

// ─── Admin ──────────────────────────────────────────────────────────────────

/// Append-only record of privileged actions (verifications, suspensions,
/// dispute decisions). Never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "license.verify", "user.suspend"
  targetType String // e.g. "PsychologistProfile", "User", "Dispute"
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
}

// ─── Section 4: psychologist workspace ──────────────────────────────────────

/// Configurable pricing plans (free listing, Pro, commission). Edited by admins.
model Plan {
  id                String   @id @default(cuid())
  slug              String   @unique
  /// Display names per language, e.g. {"el": "Δωρεάν", "en": "Free"}.
  name              Json
  monthlyPriceCents Int      @default(0)
  /// Platform commission per paid session, in basis points (1500 = 15%).
  commissionBps     Int      @default(0)
  /// Feature flags, e.g. ["video", "analytics", "calendar_sync", "featured"].
  features          String[]
  isDefault         Boolean  @default(false)
  active            Boolean  @default(true)
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  psychologists PsychologistProfile[]
}

/// Uploaded verification documents and photos. Files live in private storage
/// (src/lib/storage.ts); only the owner and admins can download documents.
model Document {
  id             String       @id @default(cuid())
  psychologistId String
  kind           DocumentKind
  filename       String
  mimeType       String
  sizeBytes      Int
  storageKey     String       @unique
  createdAt      DateTime     @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, kind])
}

/// A calendar the psychologist subscribes us to (secret iCal URL from Google
/// or Outlook). Its events block availability.
model ExternalCalendar {
  id             String    @id @default(cuid())
  psychologistId String
  label          String
  urlEncrypted   String
  lastSyncedAt   DateTime?
  lastError      String?
  createdAt      DateTime  @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  busy         ExternalBusy[]

  @@index([psychologistId])
}

model ExternalBusy {
  id         String   @id @default(cuid())
  calendarId String
  startsAt   DateTime
  endsAt     DateTime

  calendar ExternalCalendar @relation(fields: [calendarId], references: [id], onDelete: Cascade)

  @@index([calendarId, startsAt])
}

/// One video room per online appointment.
model VideoRoom {
  id            String   @id @default(cuid())
  appointmentId String   @unique
  /// "daily" or "p2p" (built-in WebRTC, development and fallback).
  provider      String
  /// Provider room name / URL.
  providerRef   String
  createdAt     DateTime @default(now())

  appointment Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  signals     VideoSignal[]
}

/// WebRTC signalling messages for the built-in peer-to-peer video.
model VideoSignal {
  id        String   @id @default(cuid())
  roomId    String
  fromUser  String
  kind      String // "offer" | "answer" | "candidate" | "bye"
  payload   String   @db.Text
  createdAt DateTime @default(now())

  room VideoRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)

  @@index([roomId, createdAt])
}

/// Private clinical notes. Encrypted; visible only to the psychologist who
/// wrote them (not to clients, not to admins).
model SessionNote {
  id             String   @id @default(cuid())
  psychologistId String
  clientId       String
  appointmentId  String?
  bodyEncrypted  String   @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  client       User                @relation("NoteClient", fields: [clientId], references: [id])
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([psychologistId, clientId, createdAt])
}

/// Receipts issued by the psychologist (Greek "Απόδειξη Παροχής Υπηρεσιών",
/// myDATA type 11.2). Numbered per psychologist and series.
model Invoice {
  id             String        @id @default(cuid())
  psychologistId String
  appointmentId  String?       @unique
  series         String        @default("A")
  number         Int
  issueDate      DateTime      @default(now())
  clientName     String
  netCents       Int
  vatCents       Int           @default(0)
  totalCents     Int
  /// VAT rate in basis points; psychological services are usually exempt.
  vatRateBps     Int           @default(0)
  vatExemption   String?
  status         InvoiceStatus @default(draft)
  /// myDATA identifiers returned by AADE.
  mydataMark     String?
  mydataUid      String?
  mydataQrUrl    String?
  mydataError    String?
  createdAt      DateTime      @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  appointment  Appointment?        @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@unique([psychologistId, series, number])
}

/// Money the platform transfers to a psychologist (card payments, later).
model Payout {
  id              String       @id @default(cuid())
  psychologistId  String
  periodStart     DateTime
  periodEnd       DateTime
  grossCents      Int
  commissionCents Int
  netCents        Int
  status          PayoutStatus @default(scheduled)
  reference       String?
  paidAt          DateTime?
  createdAt       DateTime     @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, periodStart])
}

/// Daily counters for profile analytics.
model ProfileStat {
  psychologistId    String
  /// Local (Europe/Athens) calendar date.
  date              DateTime @db.Date
  views             Int      @default(0)
  searchAppearances Int      @default(0)
  bookingStarts     Int      @default(0)
  bookings          Int      @default(0)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([psychologistId, date])
}

// ─── Section 5: CMS and search analytics ────────────────────────────────────

/// Blog articles and static pages (about, privacy, terms...).
model ContentPage {
  id          String        @id @default(cuid())
  kind        ContentKind
  slug        String
  status      ContentStatus @default(draft)
  publishedAt DateTime?
  coverUrl    String?
  authorId    String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  translations ContentTranslation[]

  @@unique([kind, slug])
  @@index([kind, status, publishedAt])
}

model ContentTranslation {
  pageId  String
  locale  Locale
  title   String
  excerpt String?
  /// Markdown (rendered with a small safe renderer, no raw HTML).
  body    String  @db.Text

  page ContentPage @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@id([pageId, locale])
}

/// Anonymous search log for "top searches" and "no results" reports.
/// Stores the query text and filters only; never who searched.
model SearchLog {
  id          String   @id @default(cuid())
  query       String
  filters     Json?
  resultCount Int
  locale      Locale
  createdAt   DateTime @default(now())

  @@index([createdAt])
  @@index([query])
}

// ─── Section 7: compliance ──────────────────────────────────────────────────

enum ConsentKind {
  terms
  privacy
  health_data
  psychologist_terms
  optional_cookies
}

/// Proof of consent (GDPR Art. 7): what, which document version, when, and
/// when it was withdrawn. Never deleted while the account exists.
model ConsentRecord {
  id          String      @id @default(cuid())
  userId      String
  kind        ConsentKind
  version     String
  grantedAt   DateTime    @default(now())
  withdrawnAt DateTime?
  userAgent   String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, kind])
}

/// What an emailed one-time link is for. Each purpose is spent only by its own flow.
enum TokenPurpose {
  sign_in
  password_reset
  email_verify
  email_change
}

/// One-time links sent by email (sign-in, password reset, email checks).
/// Only the SHA-256 hash of the token is stored.
model LoginToken {
  id        String       @id @default(cuid())
  tokenHash String       @unique
  userId    String
  purpose   TokenPurpose @default(sign_in)
  /// The new address, for purpose = email_change.
  newEmail  String?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime     @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// Client-only details, kept apart from the login (User) so the account
/// table stays minimal. Optional by design (data minimisation).
model ClientProfile {
  id                    String       @id @default(cuid())
  userId                String       @unique
  /// Preferred session language (Language.code) and format, used as search defaults.
  preferredLanguage     String?
  preferredSessionType  SessionType?
  /// Saved "Help me choose" answers, AES-256-GCM encrypted (they can reveal health concerns).
  matchAnswersEncrypted String?      @db.Text
  matchSavedAt          DateTime?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Intake questionnaire for one appointment. Health data: answers are
/// AES-256-GCM encrypted and every view is written to the audit log.
model IntakeForm {
  id               String   @id @default(cuid())
  appointmentId    String   @unique
  /// Encrypted JSON (reason, firstTime, notes).
  answersEncrypted String   @db.Text
  /// The text suggested risk of self-harm (src/lib/risk.ts).
  riskFlag         Boolean  @default(false)
  /// Question set version, so answers stay readable when questions change.
  version          Int      @default(1)
  submittedAt      DateTime @default(now())
  updatedAt        DateTime @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

/// History of licence checks: each admin decision with the licence details
/// as they were at the time. The profile holds the current status.
model LicenseVerification {
  id                 String             @id @default(cuid())
  psychologistId     String
  licenseNumber      String
  licensingAuthority String
  countryCode        String             @db.Char(2)
  decision           VerificationStatus
  note               String?
  reviewerId         String?
  decidedAt          DateTime           @default(now())

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  reviewer     User?               @relation("LicenseReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)

  @@index([psychologistId, decidedAt])
}

/// Fixed-window counters for rate limits (sign-in, sign-up, magic links,
/// contact form, uploads). Shared by every server instance; expired rows are
/// removed by the retention job.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime

  @@index([resetAt])
}
