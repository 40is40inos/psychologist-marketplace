// Data model.
// Section 1: market, languages, currency, session types.
// Section 2: user roles (client, psychologist, admin), auth sessions,
//            license verification, disputes, audit log.
// Section 3: taxonomy, availability, booking, payments, saved psychologists,
//            messaging, notifications, feedback.
//
// Conventions
// - Money is stored as integer cents with an explicit currency (EUR for now).
// - All timestamps are stored in UTC; display uses the market's time zone.
// - Translatable text lives in *Translation tables keyed by locale, so adding
//   a language needs no schema change.
// - "Psychologist" is the role name and covers psychotherapists too; the
//   professional title is stored separately.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Locale {
  el
  en
}

enum Currency {
  EUR
}

enum SessionType {
  in_person
  video
  phone
}

enum UserRole {
  client
  psychologist
  admin
}

enum UserStatus {
  active
  suspended
}

enum ProfessionalTitle {
  psychologist
  psychotherapist
  clinical_psychologist
  counselling_psychologist
}

enum VerificationStatus {
  pending
  verified
  rejected
  suspended
}

enum AppointmentStatus {
  pending
  confirmed
  cancelled_by_client
  cancelled_by_psychologist
  completed
  no_show
}

enum Gender {
  female
  male
  nonbinary
  undisclosed
}

enum SpecialtyKind {
  concern
  approach
  client_type
}

enum AppointmentKind {
  session
  /// Free 15-minute introductory call.
  intro_call
}

enum PaymentMethod {
  pay_at_session
  card
}

enum PaymentStatus {
  pending
  paid
  refunded
  waived
  failed
}

enum NotificationChannel {
  email
  sms
}

enum NotificationKind {
  booking_confirmation
  reminder_24h
  reminder_1h
  cancellation
  reschedule
  new_message
}

enum NotificationStatus {
  pending
  sent
  failed
  skipped
}

enum DisputeStatus {
  open
  under_review
  resolved
  rejected
}

/// Markets the platform operates in. Greece first, more EU countries later.
model Country {
  code     String   @id @db.Char(2) // ISO 3166-1 alpha-2
  currency Currency @default(EUR)
  timeZone String // IANA, e.g. Europe/Athens
  enabled  Boolean  @default(false)

  cities        City[]
  psychologists PsychologistProfile[]
}

model City {
  id          String @id @default(cuid())
  countryCode String @db.Char(2)
  slug        String
  latitude    Float?
  longitude   Float?

  country      Country           @relation(fields: [countryCode], references: [code])
  translations CityTranslation[]
  offices      Office[]

  @@unique([countryCode, slug])
}

model CityTranslation {
  cityId String
  locale Locale
  name   String

  city City @relation(fields: [cityId], references: [id], onDelete: Cascade)

  @@id([cityId, locale])
}

// ─── Users and auth ─────────────────────────────────────────────────────────

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  emailVerifiedAt DateTime?
  /// scrypt hash, see src/lib/auth/password.ts.
  passwordHash    String
  name            String
  phone           String?
  role            UserRole   @default(client)
  status          UserStatus @default(active)
  /// UI and email language preference.
  locale          Locale     @default(el)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lastSignInAt    DateTime?
  /// Reminder preferences. SMS needs a phone number.
  emailReminders  Boolean    @default(true)
  smsReminders    Boolean    @default(false)
  /// Soft delete for GDPR erasure requests; personal fields are scrubbed.
  deletedAt       DateTime?

  sessions            AuthSession[]
  psychologistProfile PsychologistProfile?  @relation("ProfileOwner")
  clientAppointments  Appointment[]         @relation("ClientAppointments")
  disputesOpened      Dispute[]             @relation("DisputeOpener")
  disputesResolved    Dispute[]             @relation("DisputeResolver")
  verificationsDone   PsychologistProfile[] @relation("ProfileVerifier")
  auditEntries        AuditLog[]
  saved               SavedPsychologist[]
  clientConversations Conversation[]        @relation("ClientConversations")
  messagesSent        Message[]
  notifications       Notification[]
  feedbackGiven       Feedback[]

  @@index([role, status])
}

/// Server-side login session. The cookie holds a random token; only its
/// SHA-256 hash is stored, so a database leak does not leak live sessions.
model AuthSession {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())
  userAgent String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ─── Psychologists ──────────────────────────────────────────────────────────

model PsychologistProfile {
  id                         String             @id @default(cuid())
  userId                     String             @unique
  slug                       String             @unique
  countryCode                String             @db.Char(2)
  title                      ProfessionalTitle
  /// License to practise, checked by an admin before the profile is public.
  licenseNumber              String
  licensingAuthority         String
  verificationStatus         VerificationStatus @default(pending)
  verifiedAt                 DateTime?
  verifiedById               String?
  /// Shown to the psychologist when an application is rejected.
  rejectionReason            String?
  practisingSince            Int?
  photoUrl                   String?
  /// Optional intro video (YouTube/Vimeo URL, embedded privacy-friendly).
  videoUrl                   String?
  gender                     Gender             @default(undisclosed)
  /// Offers a free 15-minute intro call.
  introCallEnabled           Boolean            @default(false)
  /// Free cancellation up to this many hours before a session.
  cancellationHours          Int                @default(24)
  /// Share of the price charged for a late cancellation or no-show.
  lateCancellationFeePercent Int                @default(100)
  /// Minimum notice for new bookings, in hours.
  bookingNoticeHours         Int                @default(12)
  /// How far ahead clients can book, in days.
  bookingWindowDays          Int                @default(60)
  /// Languages the psychologist can hold sessions in (ISO 639-1 codes).
  sessionLanguages           String[]
  /// Psychologist's own switch; the profile is public only when this is true
  /// AND verificationStatus is verified.
  published                  Boolean            @default(false)
  createdAt                  DateTime           @default(now())
  updatedAt                  DateTime           @updatedAt

  user          User                             @relation("ProfileOwner", fields: [userId], references: [id], onDelete: Cascade)
  verifiedBy    User?                            @relation("ProfileVerifier", fields: [verifiedById], references: [id])
  country       Country                          @relation(fields: [countryCode], references: [code])
  translations  PsychologistProfileTranslation[]
  offerings     SessionOffering[]
  offices       Office[]
  specialties   PsychologistSpecialty[]
  appointments  Appointment[]
  education     PsychologistEducation[]
  faqs          PsychologistFaq[]
  availability  AvailabilityRule[]
  timeOff       TimeOff[]
  savedBy       SavedPsychologist[]
  conversations Conversation[]
  feedback      Feedback[]

  @@index([countryCode, verificationStatus, published])
}

/// Per-language profile text. A psychologist may write in one or both languages.
model PsychologistProfileTranslation {
  psychologistId String
  locale         Locale
  headline       String
  bio            String  @db.Text
  approach       String? @db.Text

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([psychologistId, locale])
}

/// A bookable session format with its own duration and price.
model SessionOffering {
  id              String      @id @default(cuid())
  psychologistId  String
  type            SessionType
  durationMinutes Int         @default(50)
  priceCents      Int
  currency        Currency    @default(EUR)
  active          Boolean     @default(true)
  /// Required for in-person sessions.
  officeId        String?

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  office       Office?             @relation(fields: [officeId], references: [id])

  @@unique([psychologistId, type])
  @@index([type, active])
}

model Office {
  id                   String  @id @default(cuid())
  psychologistId       String
  cityId               String
  addressLine          String
  postalCode           String
  latitude             Float?
  longitude            Float?
  /// Accessibility details matter for in-person care.
  wheelchairAccessible Boolean @default(false)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  city         City                @relation(fields: [cityId], references: [id])
  offerings    SessionOffering[]
}

/// Concerns, approaches and client types. Slugs match src/domain/taxonomy.ts;
/// labels live in the dictionaries so they are type-checked per language.
model Specialty {
  id            String                  @id @default(cuid())
  slug          String                  @unique
  kind          SpecialtyKind
  psychologists PsychologistSpecialty[]

  @@index([kind])
}

model PsychologistSpecialty {
  psychologistId String
  specialtyId    String

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)
  specialty    Specialty           @relation(fields: [specialtyId], references: [id], onDelete: Cascade)

  @@id([psychologistId, specialtyId])
}

model PsychologistEducation {
  id             String @id @default(cuid())
  psychologistId String
  degree         String
  institution    String
  year           Int?
  sortOrder      Int    @default(0)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId])
}

model PsychologistFaq {
  id             String @id @default(cuid())
  psychologistId String
  locale         Locale
  question       String
  answer         String @db.Text
  sortOrder      Int    @default(0)

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, locale])
}

/// Weekly working hours in the market's local time.
model AvailabilityRule {
  id             String        @id @default(cuid())
  psychologistId String
  /// ISO weekday: 1 = Monday ... 7 = Sunday.
  weekday        Int
  /// Minutes after local midnight, e.g. 540 = 09:00.
  startMinute    Int
  endMinute      Int
  /// Formats offered in this window; empty means all active formats.
  sessionTypes   SessionType[]

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, weekday])
}

/// Holidays and blocked time (UTC).
model TimeOff {
  id             String   @id @default(cuid())
  psychologistId String
  startsAt       DateTime
  endsAt         DateTime
  note           String?

  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@index([psychologistId, startsAt])
}

model SavedPsychologist {
  userId         String
  psychologistId String
  createdAt      DateTime @default(now())

  user         User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id], onDelete: Cascade)

  @@id([userId, psychologistId])
}

// ─── Appointments and disputes ──────────────────────────────────────────────

/// Minimal appointment record. Booking rules come in a later section.
model Appointment {
  id                String            @id @default(cuid())
  clientId          String
  psychologistId    String
  sessionType       SessionType
  status            AppointmentStatus @default(pending)
  startsAt          DateTime // UTC
  endsAt            DateTime // UTC
  /// Snapshot of the price at booking time, so later price changes don't
  /// rewrite history.
  priceCents        Int
  currency          Currency          @default(EUR)
  /// Language the session will be held in.
  locale            Locale
  kind              AppointmentKind   @default(session)
  paymentMethod     PaymentMethod     @default(pay_at_session)
  /// Intake answers, AES-256-GCM encrypted (src/lib/crypto.ts). Health data.
  intakeEncrypted   String?           @db.Text
  cancelledAt       DateTime?
  /// True when cancelled inside the psychologist's cancellation window.
  lateCancellation  Boolean           @default(false)
  /// Incremented on every change so calendar apps update the .ics event.
  icsSequence       Int               @default(0)
  rescheduledFromId String?           @unique
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  client          User                @relation("ClientAppointments", fields: [clientId], references: [id])
  psychologist    PsychologistProfile @relation(fields: [psychologistId], references: [id])
  disputes        Dispute[]
  payment         Payment?
  feedback        Feedback?
  notifications   Notification[]
  rescheduledFrom Appointment?        @relation("Reschedule", fields: [rescheduledFromId], references: [id])
  rescheduledTo   Appointment?        @relation("Reschedule")

  @@index([psychologistId, startsAt])
  @@index([clientId, startsAt])
}

model Payment {
  id            String        @id @default(cuid())
  appointmentId String        @unique
  amountCents   Int
  currency      Currency      @default(EUR)
  method        PaymentMethod
  status        PaymentStatus @default(pending)
  /// Payment provider and its reference (e.g. "stripe", PaymentIntent id).
  provider      String?
  providerRef   String?
  /// Sequential receipt number, assigned when the payment is marked paid.
  receiptNumber String?       @unique
  paidAt        DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
}

/// Private feedback after a session. Never public unless the client opts in
/// AND the reviews policy allows publishing.
model Feedback {
  id             String   @id @default(cuid())
  appointmentId  String   @unique
  clientId       String
  psychologistId String
  /// 1-5
  rating         Int
  comment        String?  @db.Text
  publicConsent  Boolean  @default(false)
  createdAt      DateTime @default(now())

  appointment  Appointment         @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  client       User                @relation(fields: [clientId], references: [id])
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id])

  @@index([psychologistId])
}

// ─── Messaging and notifications ────────────────────────────────────────────

/// One thread per client-psychologist pair. Opened only after a booking.
model Conversation {
  id             String   @id @default(cuid())
  clientId       String
  psychologistId String
  createdAt      DateTime @default(now())
  lastMessageAt  DateTime @default(now())

  client       User                @relation("ClientConversations", fields: [clientId], references: [id])
  psychologist PsychologistProfile @relation(fields: [psychologistId], references: [id])
  messages     Message[]

  @@unique([clientId, psychologistId])
  @@index([psychologistId, lastMessageAt])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  /// AES-256-GCM encrypted body (src/lib/crypto.ts).
  bodyEncrypted  String    @db.Text
  createdAt      DateTime  @default(now())
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id])

  @@index([conversationId, createdAt])
}

/// Outbox for emails and SMS. A cron job sends due rows.
model Notification {
  id            String              @id @default(cuid())
  userId        String
  appointmentId String?
  kind          NotificationKind
  channel       NotificationChannel
  status        NotificationStatus  @default(pending)
  scheduledFor  DateTime
  sentAt        DateTime?
  attempts      Int                 @default(0)
  error         String?
  createdAt     DateTime            @default(now())

  user        User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  appointment Appointment? @relation(fields: [appointmentId], references: [id], onDelete: Cascade)

  @@index([status, scheduledFor])
  @@index([appointmentId])
}

/// A complaint about an appointment (no-show, billing, conduct). Opened by
/// the client or the psychologist, handled by an admin.
model Dispute {
  id            String        @id @default(cuid())
  appointmentId String
  openedById    String
  reason        String        @db.Text
  status        DisputeStatus @default(open)
  resolution    String?       @db.Text
  resolvedById  String?
  resolvedAt    DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  appointment Appointment @relation(fields: [appointmentId], references: [id])
  openedBy    User        @relation("DisputeOpener", fields: [openedById], references: [id])
  resolvedBy  User?       @relation("DisputeResolver", fields: [resolvedById], references: [id])

  @@index([status, createdAt])
}

// ─── Admin ──────────────────────────────────────────────────────────────────

/// Append-only record of privileged actions (verifications, suspensions,
/// dispute decisions). Never updated or deleted by the app.
model AuditLog {
  id         String   @id @default(cuid())
  actorId    String
  action     String // e.g. "license.verify", "user.suspend"
  targetType String // e.g. "PsychologistProfile", "User", "Dispute"
  targetId   String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor User @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
}
